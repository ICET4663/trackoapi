DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public"
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
MOCK_OTP_CODE="123456"
EXPOSE_DEV_OTP="true"
ENABLE_PREVIEW_AUTH="true"
EMAIL_PROVIDER="mock"
RESEND_API_KEY=""
# The default onboarding@resend.dev only delivers to the Resend account owner's own
# address (sandbox mode). To email OTPs to any user, verify a domain at
# resend.com/domains and set this to an address on that domain, e.g.
# "Tracko <noreply@mail.tracko.ng>". Until then, registration falls back to
# returning the code in the /v1/auth/register/request response.
EMAIL_FROM="Tracko <onboarding@resend.dev>"
AUTH_RATE_LIMIT_WINDOW_MS="900000"
AUTH_OTP_RATE_LIMIT="5"
AUTH_LOGIN_RATE_LIMIT="10"
PORT="4000"
CORS_ORIGIN="http://localhost:8082,http://localhost:3000"
CRON_SECRET="replace-with-a-long-random-cron-secret"
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="tracko-media"

# Provider mode starts as mock. Add real keys only when you are ready for paid/live checks.
PAYMENT_PROVIDER="mock"
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYMENT_CALLBACK_URL="https://cargo-link-logistics-mm1c.vercel.app/customer/escrow"
PAYMENT_FALLBACK_EMAIL="payments@tracko.local"
STRIPE_SECRET_KEY=""
KYC_PROVIDER="mock"
KYC_PROVIDER_REDIRECT_URL=""
SMILE_ID_API_KEY=""
SMILE_ID_PARTNER_ID=""
DOJAH_API_KEY=""
DOJAH_APP_ID=""
MONO_SECRET_KEY=""
GOOGLE_MAPS_API_KEY=""
# Cross-language text translation (Cloud Translation API v2).
# Unset = translation is unavailable. Restrict this key to the Translation API.
GOOGLE_CLOUD_API_KEY=""
# Multilingual voice transcription (Cloud Speech-to-Text API v2). These three values
# come from a JSON key created for a service account with the Cloud Speech Client role.
GOOGLE_CLOUD_PROJECT_ID=""
GOOGLE_CLOUD_CLIENT_EMAIL=""
GOOGLE_CLOUD_PRIVATE_KEY=""
GOOGLE_SPEECH_LOCATION="us-central1"
GOOGLE_SPEECH_MODEL="chirp_2"
